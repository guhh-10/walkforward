# ==============================================================================
# Local Data, SQLite Databases & Backups
# ==============================================================================
# Ignore entire data/ directory except .gitkeep
data/*
!data/.gitkeep

# SQLite files, WAL journals, and temporary test databases
*.db
*.db-*
*.db.bak
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.backup
*.dump
test*.db
temp*.db

# Transaction CSV imports and exports containing personal finance data
*.csv
!*sample*.csv
!*example*.csv
data/exports/
data/imports/
exports/
imports/

# ==============================================================================
# Machine Learning Model Artifacts
# ==============================================================================
# Both singular and plural directory paths per spec
**/model_artifacts/*
**/models_artifacts/*
!**/model_artifacts/.gitkeep
!**/models_artifacts/.gitkeep

# Serialized pipelines and model files (category_clf_*.joblib)
*.joblib
*.pkl
*.pickle
*.onnx

# Evaluation reports, confusion matrix plots, and metrics dumps
reports/
evaluation_reports/
*.eval.json
*.metrics.json

# ==============================================================================
# Environment Configuration & Secrets
# ==============================================================================
.env
.env.*
!.env.example
!.env.template
*.pem
*.key

# ==============================================================================
# General Logs & Temporary Files
# ==============================================================================
logs/
*.log
*.tmp
*.temp

# ==============================================================================
# IDEs & Text Editors
# ==============================================================================
# JetBrains
.idea/

# Visual Studio Code (track shared config, ignore personal workspace state)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Vim / Emacs / Backup files
*.swp
*.swo
*~
*.bak

